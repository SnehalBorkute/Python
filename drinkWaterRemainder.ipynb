   "source": [
    "# Remainder after every 1 hour to drink water\n",
    "\n",
    "import time\n",
    "from plyer import notification\n",
    "notification.notify(\n",
    "    title=\"drink water\",\n",
    "    message=\"its time to drink water\",\n",
    "    timeout=2\n",
    ")\n",
    "time.sleep(60*60)"
   ]
  }
